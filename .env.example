# ChemEng Local Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ==================== AI Integration ====================
# Anthropic API key (from https://console.anthropic.com/settings/keys)
# Required for AI chat and parameter suggestion features
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# AI model (default: claude-sonnet-4-20250514)
# CHEMENG_AI_MODEL=claude-sonnet-4-20250514

# Max tokens per AI response (default: 1024)
# CHEMENG_AI_MAX_TOKENS=1024

# ==================== Server ====================
# HOST=0.0.0.0
# PORT=8000

# ==================== CORS ====================
# Comma-separated origins (default: localhost:8000)
# CHEMENG_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
